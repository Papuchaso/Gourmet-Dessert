# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL / Neon)
# ==============================================================================
# URL con Pooler para la aplicación FastAPI (Recomendada en Render)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# URL Directa para migraciones con Alembic (Opcional, necesaria si corres alembic)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# SEGURIDAD Y TOKENS JWT
# ==============================================================================
# Generar una clave segura aleatoria: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_secreta_super_segura_para_produccion
ALGORITHM=HS256
ACCESS_MIN=30
REFRESH_MIN=10080

# ==============================================================================
# INTEGRACIÓN FRONTEND & CORS
# ==============================================================================
# URL pública de tu frontend en Vercel (permite peticiones con credenciales)
# Puedes colocar una o varias separadas por coma
FRONTEND_URL=https://tu-proyecto.vercel.app


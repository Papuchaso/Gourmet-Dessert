{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app/main:app"
    },
    "tienda-frontend": {
      "root": "tienda-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/salud",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/pedidos/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/productos/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/usuarios/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/demo/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "tienda-frontend"
      }
    }
  ]
}

